{
  "name": "vscode-claude-sessions",
  "displayName": "Claude Sessions",
  "description": "Keeps Claude Code sessions in VS Code terminal tabs restorable: tab names, order and splits are saved per repository and restored with one click.",
  "version": "0.21.0",
  "publisher": "sftmlg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sftmlg/vscode-claude-sessions"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js",
    "list": "node cli.js list",
    "bench": "node bench.js",
    "verify": "node --check extension.js && node --check sessions.js && node --check cli.js && npm test",
    "release": "./release.sh"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeSessions.restore",
        "title": "Restore saved tabs",
        "category": "Claude Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "claudeSessions.captureLayout",
        "title": "Capture split layout (focus briefly cycles through the terminals)",
        "category": "Claude Sessions",
        "icon": "$(save)"
      },
      {
        "command": "claudeSessions.refresh",
        "title": "Refresh",
        "category": "Claude Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.openStateFile",
        "title": "Open state file",
        "category": "Claude Sessions",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSessions.focusTab",
        "title": "Focus tab",
        "category": "Claude Sessions"
      },
      {
        "command": "claudeSessions.resume",
        "title": "Resume in the active terminal",
        "category": "Claude Sessions",
        "icon": "$(play)"
      },
      {
        "command": "claudeSessions.resumeNewTab",
        "title": "Resume in a new tab",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.renameSaved",
        "title": "Rename",
        "category": "Claude Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSessions.removeSaved",
        "title": "Remove from saved tabs",
        "category": "Claude Sessions",
        "icon": "$(close)"
      },
      {
        "command": "claudeSessions.copyResume",
        "title": "Copy resume command",
        "category": "Claude Sessions",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSessions.renameTab",
        "title": "Rename tab",
        "category": "Claude Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSessions.archive",
        "title": "Archive (files stay)",
        "category": "Claude Sessions",
        "icon": "$(archive)"
      },
      {
        "command": "claudeSessions.unarchive",
        "title": "Move back to inactive",
        "category": "Claude Sessions",
        "icon": "$(history)"
      },
      {
        "command": "claudeSessions.closeTab",
        "title": "Close tab (session stays resumable)",
        "category": "Claude Sessions",
        "icon": "$(close)"
      },
      {
        "command": "claudeSessions.addToSplit",
        "title": "Add a terminal to this split, then pick a session or start a new one",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.openNew",
        "title": "New tab: open a terminal, then pick a session or start a new one",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.favorite",
        "title": "Add to favorites",
        "category": "Claude Sessions",
        "icon": "$(star-empty)"
      },
      {
        "command": "claudeSessions.unfavorite",
        "title": "Remove from favorites",
        "category": "Claude Sessions",
        "icon": "$(star-full)"
      },
      {
        "command": "claudeSessions.splitTab",
        "title": "Split: open a terminal to the right, then pick a session or start a new one",
        "category": "Claude Sessions",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "claudeSessions.openInTerminal",
        "title": "Start or resume a Claude session in this terminal",
        "category": "Claude Sessions",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.searchInactive",
        "title": "Search inactive sessions by name or content",
        "category": "Claude Sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.clearSearch",
        "title": "Clear search",
        "category": "Claude Sessions",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSessions.switchSession",
        "title": "Search a session and open it in this tab",
        "category": "Claude Sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeSessions.deleteSession",
        "title": "Delete session completely (files go to the Trash)",
        "category": "Claude Sessions",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSessions.openSessionFile",
        "title": "Open session file",
        "category": "Claude Sessions",
        "icon": "$(go-to-file)"
      },
      {
        "command": "claudeSessions.checkForUpdates",
        "title": "Check for plugin updates",
        "category": "Claude Sessions",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeSessions.connectNextcloud",
        "title": "Connect Nextcloud to sync favorite sessions across machines",
        "category": "Claude Sessions",
        "icon": "$(plug)"
      },
      {
        "command": "claudeSessions.syncNow",
        "title": "Sync favorite sessions with Nextcloud now",
        "category": "Claude Sessions",
        "icon": "$(sync)"
      },
      {
        "command": "claudeSessions.disconnectNextcloud",
        "title": "Disconnect Nextcloud",
        "category": "Claude Sessions",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "claudeSessions.reloadWindow",
        "title": "Reload to use the new version",
        "category": "Claude Sessions",
        "icon": "$(debug-restart)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "Claude Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "id": "claudeSessions.inactive",
          "name": "Inactive"
        },
        {
          "id": "claudeSessions.active",
          "name": "Active"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.reloadWindow",
          "when": "view == claudeSessions.inactive && claudeSessions.updated",
          "group": "navigation@-1"
        },
        {
          "command": "claudeSessions.searchInactive",
          "when": "view == claudeSessions.inactive",
          "group": "navigation@0"
        },
        {
          "command": "claudeSessions.clearSearch",
          "when": "view == claudeSessions.inactive && claudeSessions.searching",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.openNew",
          "when": "view == claudeSessions.active",
          "group": "navigation@1"
        },
        {
          "command": "claudeSessions.restore",
          "when": "view == claudeSessions.active",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.refresh",
          "when": "view == claudeSessions.active || view == claudeSessions.inactive",
          "group": "navigation@9"
        },
        {
          "command": "claudeSessions.openStateFile",
          "when": "view == claudeSessions.inactive",
          "group": "navigation@3"
        },
        {
          "command": "claudeSessions.checkForUpdates",
          "when": "view == claudeSessions.inactive",
          "group": "navigation@8"
        },
        {
          "command": "claudeSessions.syncNow",
          "when": "view == claudeSessions.inactive && claudeSessions.syncConnected",
          "group": "navigation@7"
        },
        {
          "command": "claudeSessions.connectNextcloud",
          "when": "view == claudeSessions.inactive && !claudeSessions.syncConnected",
          "group": "sync@1"
        },
        {
          "command": "claudeSessions.disconnectNextcloud",
          "when": "view == claudeSessions.inactive && claudeSessions.syncConnected",
          "group": "sync@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSessions.favorite",
          "when": "viewItem =~ /^(session|savedTab|archivedSession|activeTab|activeTabInSplit)$/",
          "group": "inline@0"
        },
        {
          "command": "claudeSessions.addToSplit",
          "when": "viewItem == split",
          "group": "inline@1"
        },
        {
          "command": "claudeSessions.unfavorite",
          "when": "viewItem =~ /\\.fav$/",
          "group": "inline@0"
        },
        {
          "command": "claudeSessions.renameTab",
          "when": "viewItem =~ /^activeTab(\\.fav)?$/ || viewItem =~ /^activeTabInSplit(\\.fav)?$/",
          "group": "inline@3"
        },
        {
          "command": "claudeSessions.closeTab",
          "when": "viewItem =~ /^(activeTab|activeTabInSplit)(\\.fav)?$/ || viewItem == activeTerminal || viewItem == activeTerminalInSplit",
          "group": "inline@7"
        },
        {
          "command": "claudeSessions.resume",
          "when": "viewItem =~ /^session(\\.fav)?$/ || viewItem =~ /^savedTab(\\.fav)?$/ || viewItem =~ /^archivedSession(\\.fav)?$/",
          "group": "inline@3"
        },
        {
          "command": "claudeSessions.resumeNewTab",
          "when": "viewItem =~ /^session(\\.fav)?$/ || viewItem =~ /^savedTab(\\.fav)?$/ || viewItem =~ /^archivedSession(\\.fav)?$/",
          "group": "inline@4"
        },
        {
          "command": "claudeSessions.renameSaved",
          "when": "viewItem =~ /^session(\\.fav)?$/ || viewItem =~ /^savedTab(\\.fav)?$/ || viewItem =~ /^archivedSession(\\.fav)?$/",
          "group": "inline@5"
        },
        {
          "command": "claudeSessions.archive",
          "when": "viewItem =~ /^session(\\.fav)?$/ || viewItem =~ /^savedTab(\\.fav)?$/",
          "group": "inline@7"
        },
        {
          "command": "claudeSessions.unarchive",
          "when": "viewItem =~ /^archivedSession(\\.fav)?$/",
          "group": "inline@7"
        },
        {
          "command": "claudeSessions.removeSaved",
          "when": "viewItem =~ /^savedTab(\\.fav)?$/",
          "group": "2_manage"
        },
        {
          "command": "claudeSessions.copyResume",
          "when": "viewItem =~ /^session(\\.fav)?$/ || viewItem =~ /^savedTab(\\.fav)?$/ || viewItem =~ /^archivedSession(\\.fav)?$/ || viewItem =~ /^activeTab(\\.fav)?$/ || viewItem =~ /^activeTabInSplit(\\.fav)?$/",
          "group": "1_copy"
        },
        {
          "command": "claudeSessions.splitTab",
          "when": "viewItem =~ /^(activeTab|activeTabInSplit)(\\.fav)?$/ || viewItem == activeTerminal || viewItem == activeTerminalInSplit",
          "group": "inline@4"
        },
        {
          "command": "claudeSessions.openInTerminal",
          "when": "viewItem == activeTerminal || viewItem == activeTerminalInSplit",
          "group": "inline@2"
        },
        {
          "command": "claudeSessions.switchSession",
          "when": "viewItem =~ /^(activeTab|activeTabInSplit)(\\.fav)?$/",
          "group": "inline@2"
        },
        {
          "command": "claudeSessions.deleteSession",
          "when": "viewItem =~ /^(activeTab|activeTabInSplit)(\\.fav)?$/",
          "group": "inline@6"
        },
        {
          "command": "claudeSessions.deleteSession",
          "when": "viewItem =~ /^(session|savedTab|archivedSession)(\\.fav)?$/",
          "group": "inline@6"
        },
        {
          "command": "claudeSessions.openSessionFile",
          "when": "viewItem =~ /^(activeTab|activeTabInSplit)(\\.fav)?$/",
          "group": "1_copy"
        }
      ],
      "terminal/title/context": [
        {
          "command": "claudeSessions.renameTab",
          "group": "navigation@0"
        }
      ],
      "terminal/context": [
        {
          "command": "claudeSessions.renameTab",
          "group": "z_claude"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeSessions.focusTab",
          "when": "false"
        },
        {
          "command": "claudeSessions.resume",
          "when": "false"
        },
        {
          "command": "claudeSessions.resumeNewTab",
          "when": "false"
        },
        {
          "command": "claudeSessions.renameSaved",
          "when": "false"
        },
        {
          "command": "claudeSessions.removeSaved",
          "when": "false"
        },
        {
          "command": "claudeSessions.copyResume",
          "when": "false"
        },
        {
          "command": "claudeSessions.archive",
          "when": "false"
        },
        {
          "command": "claudeSessions.unarchive",
          "when": "false"
        },
        {
          "command": "claudeSessions.closeTab",
          "when": "false"
        },
        {
          "command": "claudeSessions.addToSplit",
          "when": "false"
        },
        {
          "command": "claudeSessions.favorite",
          "when": "false"
        },
        {
          "command": "claudeSessions.unfavorite",
          "when": "false"
        },
        {
          "command": "claudeSessions.splitTab",
          "when": "false"
        },
        {
          "command": "claudeSessions.openInTerminal",
          "when": "false"
        },
        {
          "command": "claudeSessions.switchSession",
          "when": "false"
        },
        {
          "command": "claudeSessions.deleteSession",
          "when": "false"
        },
        {
          "command": "claudeSessions.openSessionFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Claude Sessions",
      "properties": {
        "claudeSessions.storageFile": {
          "type": "string",
          "default": ".vscode/claude-sessions.json",
          "scope": "resource",
          "description": "State file inside the repository (relative to its root). Whether it is committed is up to the repository's .gitignore."
        },
        "claudeSessions.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command used to resume a session; `--resume <id>` is appended."
        },
        "claudeSessions.openIn": {
          "type": "string",
          "enum": [
            "activeTerminal",
            "newTab"
          ],
          "default": "activeTerminal",
          "enumDescriptions": [
            "Use the active terminal: an idle shell starts the session, a running Claude switches via /resume, a busy terminal gets a new tab.",
            "Always open a new tab."
          ],
          "description": "Where the play button opens a session."
        },
        "claudeSessions.autoCaptureLayout": {
          "type": "boolean",
          "default": true,
          "description": "Capture splits on start (focus cycles through the terminals once) and place terminals you open yourself with one pane check. Closing never moves focus."
        },
        "claudeSessions.pollSeconds": {
          "type": "number",
          "default": 5,
          "description": "How often tab names and sessions are re-read."
        },
        "claudeSessions.historyDays": {
          "type": "number",
          "default": 30,
          "description": "How far back the inactive and archive lists reach, by last message."
        },
        "claudeSessions.sync.server": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Nextcloud address used for syncing favorite sessions, set by Connect Nextcloud."
        },
        "claudeSessions.sync.credentialsFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional JSON file with server, loginName and appPassword (as written by `node cli.js sync login`), used when this machine has not run Connect Nextcloud. Relative paths start at the workspace folder; ~ is your home folder."
        },
        "claudeSessions.sync.folder": {
          "type": "string",
          "default": "Claude Sessions",
          "description": "Folder in your Nextcloud files that holds the synced sessions, one subfolder per repository."
        },
        "claudeSessions.sync.auto": {
          "type": "boolean",
          "default": true,
          "description": "Sync favorite sessions 3 s after start, every 10 minutes and 5 s after a star changes. Off: only Sync now."
        },
        "claudeSessions.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Check the GitHub releases of this extension every hour and install a newer version automatically."
        }
      }
    }
  }
}
